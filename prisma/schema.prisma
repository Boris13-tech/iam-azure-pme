datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  azureId   String?  @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles           UserRole[]
  auditLogs       AuditLog[]
  migrationBridge LegacyUserBridge?
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id        String   @id @default(uuid())
  action    String
  resource  String
  scope     String?
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@unique([action, resource])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  target    String?
  ip        String?
  result    String?
  timestamp DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model AccessPolicy {
  id               String   @id @default("global")
  mfa              Boolean  @default(true)
  geoBlock         Boolean  @default(false)
  sessionTimeout   Boolean  @default(true)
  passwordRotation Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

// ----------------------------------------------------------------------
// NEW LUXIA IDENTITY CORE MODELS (PHASE 2 - IDENTITY FOUNDATION)
// ----------------------------------------------------------------------

enum SubjectType {
  HUMAN
  WORKLOAD
  SERVICE
  DEVICE
  AI_AGENT
}

enum ProviderType {
  MICROSOFT_ENTRA
  LUXIA_LOCAL
  AWS
  GOOGLE_WORKSPACE
  GITHUB
  CUSTOM
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants                Tenant[]
  providerConnections    ProviderConnection[]
  subjects               Subject[]
  resources              Resource[]
  localIdentities        LocalIdentity[]
  localAuthenticators    LocalAuthenticator[]
  localAuthChallenges    LocalAuthChallenge[]
  localRecoveryCodes     LocalRecoveryCode[]
  authenticationEvidence AuthenticationEvidence[]
  cryptoKeyVersions      CryptoKeyVersion[]
  trustAnchorVersions    TrustAnchorVersion[]
  continuityStates       IdentityContinuityState[]
  offlineChallenges      OfflineIdentityChallenge[]
  assuranceSnapshots     IdentityAssuranceSnapshot[]
  continuityEvents       IdentityContinuityEvent[]
  continuityConflicts    IdentityContinuityConflict[]
}

model Tenant {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization           Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subjects               Subject[]
  resources              Resource[]
  Session                Session[]
  Entitlement            Entitlement[]
  localIdentities        LocalIdentity[]
  localAuthenticators    LocalAuthenticator[]
  localAuthChallenges    LocalAuthChallenge[]
  localRecoveryCodes     LocalRecoveryCode[]
  authenticationEvidence AuthenticationEvidence[]
  cryptoKeyVersions      CryptoKeyVersion[]
  trustAnchorVersions    TrustAnchorVersion[]
  continuityState        IdentityContinuityState?
  offlineChallenges      OfflineIdentityChallenge[]
  assuranceSnapshots     IdentityAssuranceSnapshot[]
  continuityEvents       IdentityContinuityEvent[]
  continuityConflicts    IdentityContinuityConflict[]

  @@unique([organizationId, id])
  @@index([organizationId])
}

model ProviderConnection {
  id              String       @id @default(uuid())
  organizationId  String
  providerType    ProviderType
  externalScopeId String // e.g., Entra Tenant ID, AWS Account ID
  name            String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  identityAccounts       IdentityAccount[]
  resources              Resource[]
  authenticationEvidence AuthenticationEvidence[]

  @@unique([organizationId, id])
  @@unique([organizationId, providerType, externalScopeId])
  @@index([organizationId])
}

model Subject {
  id                 String                @id @default(uuid())
  organizationId     String
  tenantId           String
  type               SubjectType
  name               String
  lifecycleState     SubjectLifecycleState @default(ACTIVE)
  lifecycleVersion   Int                   @default(1)
  lifecycleChangedAt DateTime              @default(now())
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization           Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant                 Tenant                       @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  identities             IdentityAccount[]
  legacyBridge           LegacyUserBridge?
  Session                Session[]
  Assignment             Assignment[]
  authenticationEvidence AuthenticationEvidence[]
  boundAuthenticators    LocalAuthenticator[]         @relation("DeviceBoundAuthenticators")
  offlineChallenges      OfflineIdentityChallenge[]
  assuranceSnapshots     IdentityAssuranceSnapshot[]
  continuityEvents       IdentityContinuityEvent[]
  continuityConflicts    IdentityContinuityConflict[]

  @@unique([organizationId, id])
  @@unique([organizationId, tenantId, id])
  @@index([organizationId, tenantId])
}

model IdentityAccount {
  id                   String   @id @default(uuid())
  organizationId       String
  tenantId             String
  subjectId            String
  providerConnectionId String
  externalObjectId     String // e.g., Entra User OID
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subject                Subject                  @relation(fields: [organizationId, tenantId, subjectId], references: [organizationId, tenantId, id], onDelete: Restrict)
  providerConnection     ProviderConnection       @relation(fields: [organizationId, providerConnectionId], references: [organizationId, id], onDelete: Restrict)
  Session                Session[]
  localIdentity          LocalIdentity?
  authenticationEvidence AuthenticationEvidence[]

  @@unique([organizationId, id])
  @@unique([organizationId, tenantId, id])
  @@unique([organizationId, tenantId, subjectId, id])
  @@unique([organizationId, providerConnectionId, externalObjectId])
  @@index([organizationId])
  @@index([organizationId, tenantId, subjectId])
  @@index([organizationId, providerConnectionId])
}

enum SubjectLifecycleState {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DISABLED
  RECOVERY_REQUIRED
  RETIRED
}

enum AuthenticationMethod {
  PASSKEY
  SECURITY_KEY
  TOTP
  SMART_CARD
  MANAGED_DEVICE
  FEDERATED_OIDC
  DEVICE_KEY
  WORKLOAD_KEY
  SERVICE_KEY
  AGENT_KEY
  CUSTOM
}

enum AuthenticationAssuranceLevel {
  LOW
  SUBSTANTIAL
  HIGH
}

enum AuthenticationEvidenceOutcome {
  VERIFIED
  REJECTED
}

enum AuthenticationEvidenceSource {
  LOCAL_VERIFIER
  EXTERNAL_PROVIDER
}

enum AuthenticationUserVerification {
  VERIFIED
  PROVIDER_ASSERTED
  NOT_VERIFIED
  NOT_APPLICABLE
}

/// Provider-neutral, append-oriented authentication provenance. Higher layers
/// consume this evidence; it does not encode an authorization decision.
model AuthenticationEvidence {
  id                      String                         @id @default(uuid())
  organizationId          String
  tenantId                String
  subjectId               String
  identityAccountId       String?
  providerConnectionId    String
  schemaVersion           Int                            @default(1)
  method                  AuthenticationMethod
  outcome                 AuthenticationEvidenceOutcome
  assuranceLevel          AuthenticationAssuranceLevel
  assuranceProfile        String
  assuranceProfileVersion Int
  phishingResistant       Boolean
  hardwareBound           Boolean
  userVerification        AuthenticationUserVerification
  source                  AuthenticationEvidenceSource
  sourceRef               String
  verifierPolicyVersion   Int
  operationId             String
  correlationId           String?
  causationId             String?
  reasonCode              String
  algorithmId             String?
  algorithmVersion        Int?
  keyId                   String?
  keyVersion              String?
  trustAnchorId           String?
  trustAnchorVersion      Int?
  cryptoSchemaVersion     Int                            @default(1)
  evidenceDigest          String?
  offline                 Boolean                        @default(false)
  partitionEpoch          BigInt?
  occurredAt              DateTime
  expiresAt               DateTime?
  recordedAt              DateTime                       @default(now())

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant             Tenant             @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  subject            Subject            @relation(fields: [organizationId, tenantId, subjectId], references: [organizationId, tenantId, id], onDelete: Restrict)
  identityAccount    IdentityAccount?   @relation(fields: [organizationId, tenantId, subjectId, identityAccountId], references: [organizationId, tenantId, subjectId, id], onDelete: Restrict)
  providerConnection ProviderConnection @relation(fields: [organizationId, providerConnectionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, tenantId, id])
  @@index([organizationId, tenantId, subjectId, occurredAt])
  @@index([organizationId, tenantId, identityAccountId, occurredAt])
  @@index([organizationId, tenantId, operationId])
}

enum LocalIdentityStatus {
  ACTIVE
  DISABLED
  LOCKED
  RECOVERY_REQUIRED
}

enum LocalAuthenticatorType {
  PASSKEY
  TOTP
  SECURITY_KEY
  SMART_CARD
  MANAGED_DEVICE
  CUSTOM
}

enum LocalAuthenticatorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  COMPROMISED
  EXPIRED
  SUPERSEDED
}

enum LocalChallengePurpose {
  AUTHENTICATION
  ENROLLMENT
  RECOVERY
}

/// Tenant-scoped authentication profile for a canonical IdentityAccount.
/// Authentication material is held by authenticators; identity ownership remains in Subject.
model LocalIdentity {
  id                String              @id @default(uuid())
  organizationId    String
  tenantId          String
  identityAccountId String
  principalName     String
  status            LocalIdentityStatus @default(ACTIVE)
  failedAttempts    Int                 @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant          Tenant               @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  identityAccount IdentityAccount      @relation(fields: [organizationId, tenantId, identityAccountId], references: [organizationId, tenantId, id], onDelete: Restrict)
  authenticators  LocalAuthenticator[]
  authChallenges  LocalAuthChallenge[]
  recoveryCodes   LocalRecoveryCode[]

  @@unique([organizationId, tenantId, id])
  @@unique([organizationId, tenantId, identityAccountId])
  @@unique([organizationId, tenantId, principalName])
  @@index([organizationId, tenantId, status])
}

/// Public verification material and opaque secret references only. Never stores biometric templates.
model LocalAuthenticator {
  id                          String                   @id @default(uuid())
  organizationId              String
  tenantId                    String
  identityAccountId           String
  type                        LocalAuthenticatorType
  status                      LocalAuthenticatorStatus @default(ACTIVE)
  credentialId                String?
  publicKey                   String?
  secretRef                   String?
  secretVersion               String?
  credentialSchemaVersion     Int                      @default(1)
  credentialFormat            String                   @default("LUXIA_LOCAL_LEGACY")
  credentialFormatVersion     Int                      @default(1)
  algorithmId                 String                   @default("LEGACY_UNSPECIFIED")
  algorithmVersion            Int                      @default(1)
  keyId                       String?
  keyVersion                  Int                      @default(1)
  trustAnchorId               String?
  trustAnchorVersion          Int?
  verifierPolicyVersion       Int                      @default(1)
  stateVersion                Int                      @default(1)
  hardwareBound               Boolean                  @default(false)
  deviceSubjectId             String?
  userVerificationRequired    Boolean                  @default(false)
  migratedFromAuthenticatorId String?
  supersededByAuthenticatorId String?
  relyingPartyId              String?
  allowedOrigin               String?
  signCount                   BigInt                   @default(0)
  lastTotpStep                BigInt?
  enrolledAt                  DateTime                 @default(now())
  lastUsedAt                  DateTime?
  revokedAt                   DateTime?
  compromisedAt               DateTime?
  expiresAt                   DateTime?
  updatedAt                   DateTime                 @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant        Tenant        @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  localIdentity LocalIdentity @relation(fields: [organizationId, tenantId, identityAccountId], references: [organizationId, tenantId, identityAccountId], onDelete: Restrict)
  deviceSubject Subject?      @relation("DeviceBoundAuthenticators", fields: [organizationId, tenantId, deviceSubjectId], references: [organizationId, tenantId, id], onDelete: Restrict)

  @@unique([organizationId, tenantId, id])
  @@unique([organizationId, tenantId, credentialId])
  @@index([organizationId, tenantId, identityAccountId, status])
  @@index([organizationId, tenantId, deviceSubjectId])
}

enum CryptoKeyPurpose {
  CREDENTIAL_VERIFICATION
  EVIDENCE_SIGNING
  SECRET_ENCRYPTION
  RECOVERY
  SYNCHRONIZATION
  UPDATE_VERIFICATION
}

enum CryptoKeyStatus {
  PENDING
  ACTIVE
  VERIFY_ONLY
  REVOKED
  COMPROMISED
  RETIRED
}

enum TrustAnchorStatus {
  PENDING
  ACTIVE
  VERIFY_ONLY
  REVOKED
  COMPROMISED
  RETIRED
}

/// Version metadata only. Private key bytes remain inside the referenced custody service.
model CryptoKeyVersion {
  id               String           @id @default(uuid())
  organizationId   String
  tenantId         String
  logicalKeyId     String
  version          Int
  purpose          CryptoKeyPurpose
  algorithmId      String
  algorithmVersion Int
  status           CryptoKeyStatus  @default(PENDING)
  publicMaterial   String?
  custodyRef       String?
  custodyVersion   String?
  activatedAt      DateTime?
  verifyUntil      DateTime?
  revokedAt        DateTime?
  compromisedAt    DateTime?
  retiredAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, tenantId, id])
  @@unique([organizationId, tenantId, logicalKeyId, version])
  @@index([organizationId, tenantId, purpose, status])
}

/// Public trust material stays available for historical evidence verification after rotation.
model TrustAnchorVersion {
  id               String            @id @default(uuid())
  organizationId   String
  tenantId         String
  trustAnchorId    String
  version          Int
  algorithmId      String
  algorithmVersion Int
  status           TrustAnchorStatus @default(PENDING)
  publicMaterial   String
  fingerprint      String
  validFrom        DateTime
  validUntil       DateTime?
  revokedAt        DateTime?
  compromisedAt    DateTime?
  retiredAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, tenantId, id])
  @@unique([organizationId, tenantId, trustAnchorId, version])
  @@unique([organizationId, tenantId, fingerprint])
  @@index([organizationId, tenantId, status])
}

enum IdentityContinuityMode {
  CONNECTED
  DEGRADED
  PARTITIONED
  OFFLINE
  RECOVERING
}

enum IdentityContinuityEventType {
  MODE_TRANSITION
  OFFLINE_CHALLENGE_ISSUED
  OFFLINE_PROOF_VERIFIED
  SNAPSHOT_ISSUED
  SNAPSHOT_REJECTED
  RECONCILIATION_STARTED
  RECONCILIATION_APPLIED
  RECONCILIATION_CONFLICT
  RECONCILIATION_COMPLETED
}

enum IdentityContinuityConflictStatus {
  QUARANTINED
  RESOLVED_KEEP_LOCAL
  RESOLVED_APPLY_RESTRICTIVE
  RESOLVED_REVIEWED
}

/// Tenant-local continuity checkpoint. Canonical Subject state is never provider-owned.
model IdentityContinuityState {
  organizationId  String
  tenantId        String
  mode            IdentityContinuityMode @default(CONNECTED)
  partitionEpoch  BigInt                 @default(0)
  sequence        BigInt                 @default(0)
  enteredAt       DateTime               @default(now())
  lastConnectedAt DateTime?
  updatedAt       DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, tenantId])
  @@index([organizationId, tenantId, mode])
}

/// Fresh, signed, single-use challenge metadata. Only the nonce digest is persisted.
model OfflineIdentityChallenge {
  id                 String                 @id @default(uuid())
  organizationId     String
  tenantId           String
  subjectId          String
  verifierId         String
  audience           String
  purpose            String
  nonceDigest        String
  partitionEpoch     BigInt
  continuityMode     IdentityContinuityMode
  algorithmId        String
  algorithmVersion   Int
  issuerKeyId        String
  issuerKeyVersion   Int
  challengeSignature String
  issuedAt           DateTime
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime               @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  subject      Subject      @relation(fields: [organizationId, tenantId, subjectId], references: [organizationId, tenantId, id], onDelete: Restrict)

  @@unique([organizationId, tenantId, id])
  @@unique([organizationId, tenantId, nonceDigest])
  @@index([organizationId, tenantId, subjectId, expiresAt])
  @@index([organizationId, tenantId, consumedAt])
}

/// Signed identity assurance only; it is never an access token or authorization decision.
model IdentityAssuranceSnapshot {
  id                     String                       @id @default(uuid())
  organizationId         String
  tenantId               String
  subjectId              String
  schemaVersion          Int                          @default(1)
  issuer                 String
  audience               String
  purpose                String
  scopeDigest            String
  evidenceDigest         String
  assuranceProfile       String
  assuranceLevel         AuthenticationAssuranceLevel
  partitionEpoch         BigInt
  sequence               BigInt
  lifecycleVersion       BigInt
  credentialStateVersion BigInt
  algorithmId            String
  algorithmVersion       Int
  issuerKeyId            String
  issuerKeyVersion       Int
  signature              String
  issuedAt               DateTime
  expiresAt              DateTime
  revokedAt              DateTime?
  createdAt              DateTime                     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  subject      Subject      @relation(fields: [organizationId, tenantId, subjectId], references: [organizationId, tenantId, id], onDelete: Restrict)

  @@unique([organizationId, tenantId, id])
  @@unique([organizationId, tenantId, subjectId, partitionEpoch, sequence])
  @@index([organizationId, tenantId, subjectId, expiresAt])
}

model IdentityContinuityEvent {
  id             String                      @id @default(uuid())
  organizationId String
  tenantId       String
  subjectId      String?
  eventType      IdentityContinuityEventType
  mode           IdentityContinuityMode
  partitionEpoch BigInt
  sequence       BigInt
  operationId    String
  reasonCode     String
  evidenceDigest String?
  occurredAt     DateTime
  recordedAt     DateTime                    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  subject      Subject?     @relation(fields: [organizationId, tenantId, subjectId], references: [organizationId, tenantId, id], onDelete: Restrict)

  @@unique([organizationId, tenantId, id])
  @@unique([organizationId, tenantId, partitionEpoch, sequence])
  @@index([organizationId, tenantId, subjectId, occurredAt])
}

/// Conflicting security state is quarantined; it is never last-write-wins merged.
model IdentityContinuityConflict {
  id             String                           @id @default(uuid())
  organizationId String
  tenantId       String
  subjectId      String?
  entityType     String
  entityId       String
  localVersion   BigInt
  remoteVersion  BigInt
  localDigest    String
  remoteDigest   String
  reasonCode     String
  status         IdentityContinuityConflictStatus @default(QUARANTINED)
  detectedAt     DateTime                         @default(now())
  resolvedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  subject      Subject?     @relation(fields: [organizationId, tenantId, subjectId], references: [organizationId, tenantId, id], onDelete: Restrict)

  @@unique([organizationId, tenantId, id])
  @@index([organizationId, tenantId, status, detectedAt])
  @@index([organizationId, tenantId, entityType, entityId])
}

/// Stores only a hash of the challenge; challenges are expiring and single-use.
model LocalAuthChallenge {
  id                String                @id @default(uuid())
  organizationId    String
  tenantId          String
  identityAccountId String
  authenticatorId   String?
  purpose           LocalChallengePurpose
  challengeHash     String
  expiresAt         DateTime
  usedAt            DateTime?
  attempts          Int                   @default(0)
  maxAttempts       Int                   @default(5)
  createdAt         DateTime              @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant        Tenant        @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  localIdentity LocalIdentity @relation(fields: [organizationId, tenantId, identityAccountId], references: [organizationId, tenantId, identityAccountId], onDelete: Restrict)

  @@unique([organizationId, tenantId, id])
  @@index([organizationId, tenantId, identityAccountId, purpose])
  @@index([expiresAt])
}

/// High-entropy recovery codes are persisted as hashes and consumed once.
model LocalRecoveryCode {
  id                String    @id @default(uuid())
  organizationId    String
  tenantId          String
  identityAccountId String
  codeHash          String
  expiresAt         DateTime?
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant        Tenant        @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  localIdentity LocalIdentity @relation(fields: [organizationId, tenantId, identityAccountId], references: [organizationId, tenantId, identityAccountId], onDelete: Restrict)

  @@unique([organizationId, tenantId, id])
  @@unique([organizationId, tenantId, codeHash])
  @@index([organizationId, tenantId, identityAccountId])
}

enum ResourceType {
  APPLICATION
  API
  DATASET
  DATABASE
  REPOSITORY
  CLOUD_RESOURCE
  SAAS
  STORAGE
  SECRET
  AI_TOOL
  OTHER
}

model Resource {
  id                   String  @id @default(uuid())
  organizationId       String
  tenantId             String
  providerConnectionId String?

  name String
  type ResourceType

  externalId  String?
  description String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant             Tenant              @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  providerConnection ProviderConnection? @relation(fields: [organizationId, providerConnectionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, tenantId])
  @@index([organizationId, providerConnectionId])
}

// ----------------------------------------------------------------------
// MIGRATION BRIDGE (PHASE 2 - COMMIT D)
// ----------------------------------------------------------------------

enum MigrationStatus {
  PENDING
  LINKED
  VALIDATED
  FAILED
}

model LegacyUserBridge {
  id             String          @id @default(uuid())
  legacyUserId   String          @unique
  organizationId String
  subjectId      String
  status         MigrationStatus @default(PENDING)

  migratedAt  DateTime?
  validatedAt DateTime?
  error       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  legacyUser User    @relation(fields: [legacyUserId], references: [id], onDelete: Restrict)
  subject    Subject @relation(fields: [organizationId, subjectId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, subjectId])
  @@index([organizationId])
}

// ----------------------------------------------------------------------
// SESSION MANAGEMENT (PHASE 3 - COMMIT A)
// ----------------------------------------------------------------------

model Session {
  id                String @id
  organizationId    String
  tenantId          String
  subjectId         String
  identityAccountId String

  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  ipHash        String?
  userAgentHash String?

  tenant          Tenant          @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  subject         Subject         @relation(fields: [organizationId, tenantId, subjectId], references: [organizationId, tenantId, id], onDelete: Restrict)
  identityAccount IdentityAccount @relation(fields: [organizationId, tenantId, subjectId, identityAccountId], references: [organizationId, tenantId, subjectId, id], onDelete: Restrict)

  @@index([organizationId])
  @@index([subjectId])
}

model AuthTransaction {
  id                           String    @id
  stateHash                    String    @unique
  nonce                        String
  codeVerifier                 String
  expectedOrganizationId       String
  expectedTenantId             String
  expectedProviderConnectionId String
  returnTo                     String?
  expiresAt                    DateTime
  consumedAt                   DateTime?
  createdAt                    DateTime  @default(now())

  @@index([expiresAt])
}

enum AssignmentSource {
  LEGACY_ROLE
  DIRECT
  PROVIDER
  POLICY
  SYSTEM
}

enum AssignmentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Entitlement {
  id             String       @id @default(uuid())
  organizationId String
  tenantId       String
  key            String
  action         String
  resource       String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [organizationId, tenantId], references: [organizationId, id], onDelete: Restrict)
  assignments    Assignment[]

  @@unique([organizationId, tenantId, id])
  @@unique([organizationId, tenantId, key])
  @@index([organizationId, tenantId])
}

model Assignment {
  id             String           @id @default(uuid())
  organizationId String
  tenantId       String
  subjectId      String
  entitlementId  String
  source         AssignmentSource
  sourceRef      String?
  status         AssignmentStatus @default(ACTIVE)
  validFrom      DateTime?
  validUntil     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  subject        Subject          @relation(fields: [organizationId, tenantId, subjectId], references: [organizationId, tenantId, id], onDelete: Restrict)
  entitlement    Entitlement      @relation(fields: [organizationId, tenantId, entitlementId], references: [organizationId, tenantId, id], onDelete: Restrict)

  @@unique([organizationId, tenantId, id])
  @@index([organizationId, tenantId, subjectId, status])
  @@index([organizationId, tenantId, entitlementId])
}

enum AuthorizationShadowStatus {
  PARITY
  DIVERGENCE
  NATIVE_ERROR
  LEGACY_ERROR
}

model AuthorizationShadowObservation {
  id String @id @default(uuid())

  organizationId String
  tenantId       String
  subjectId      String

  action   String
  resource String

  legacyAllowed Boolean?
  nativeAllowed Boolean?

  nativeReasonCode String?

  status AuthorizationShadowStatus

  nativeAssignmentIds  Json?
  nativeEntitlementIds Json?

  errorCode String?

  createdAt DateTime @default(now())

  @@index([organizationId, tenantId, createdAt])
  @@index([status, createdAt])
}
