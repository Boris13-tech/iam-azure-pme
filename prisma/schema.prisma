datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  azureId   String?  @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles     UserRole[]
  auditLogs AuditLog[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id        String   @id @default(uuid())
  action    String
  resource  String
  scope     String?
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@unique([action, resource])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  target    String?
  ip        String?
  result    String?
  timestamp DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model AccessPolicy {
  id               String   @id @default("global")
  mfa              Boolean  @default(true)
  geoBlock         Boolean  @default(false)
  sessionTimeout   Boolean  @default(true)
  passwordRotation Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

// ----------------------------------------------------------------------
// NEW LUXIA IDENTITY CORE MODELS (PHASE 2 - IDENTITY FOUNDATION)
// ----------------------------------------------------------------------

enum SubjectType {
  HUMAN
  WORKLOAD
  SERVICE
  DEVICE
  AI_AGENT
}

enum ProviderType {
  MICROSOFT_ENTRA
  AWS
  GOOGLE_WORKSPACE
  GITHUB
  CUSTOM
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants             Tenant[]
  providerConnections ProviderConnection[]
  subjects            Subject[]
  resources           Resource[]
}

model Tenant {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subjects     Subject[]
  resources    Resource[]
}

model ProviderConnection {
  id               String       @id @default(uuid())
  organizationId   String
  providerType     ProviderType
  externalTenantId String // e.g., Entra Tenant ID (tid)
  name             String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  identityAccounts IdentityAccount[]
  resources        Resource[]

  @@unique([organizationId, providerType, externalTenantId])
}

model Subject {
  id             String      @id @default(uuid())
  organizationId String
  tenantId       String
  type           SubjectType
  name           String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  identities   IdentityAccount[]
}

model IdentityAccount {
  id                   String   @id @default(uuid())
  subjectId            String
  providerConnectionId String
  externalObjectId     String // e.g., Entra User OID
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  providerConnection ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)

  @@unique([providerConnectionId, externalObjectId])
}

enum ResourceType {
  APPLICATION
  API
  DATASET
  DATABASE
  REPOSITORY
  CLOUD_RESOURCE
  SAAS
  STORAGE
  SECRET
  AI_TOOL
  OTHER
}

model Resource {
  id                   String  @id @default(uuid())
  organizationId       String
  tenantId             String
  providerConnectionId String?

  name String
  type ResourceType

  externalId  String?
  description String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerConnection ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([tenantId])
  @@index([providerConnectionId])
  @@index([organizationId, tenantId])
}
