{
  "name": "iam-azure-pme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsc --noEmit && next lint && prisma validate && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "test:provider-adapters": "vitest run tests/provider-adapters",
    "test:identity": "vitest run tests/identity",
    "test:operations": "vitest run tests/operations && tsx scripts/certify-identity-v1.ts",
    "test:entra-parity": "vitest run tests/provider-adapters/microsoft-entra-adapter.contract.test.ts tests/provider-adapters/microsoft-entra-architecture.test.ts",
    "test:security:watch": "vitest tests/security",
    "postinstall": "prisma generate",
    "soak:staging": "tsx scripts/soak/run-soak.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^3.8.10",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "^5.20.0",
    "isomorphic-fetch": "^3.0.0",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "lucide-react": "^0.577.0",
    "next": "^15.5.25",
    "openid-client": "^6.8.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
